{
  "name": "cafe-kiosk-demo",
  "version": "1.0.0",
  "description": "Accessible cafe kiosk demo",
  "main": "server.mjs",
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "sdk:build": "npm run build --prefix packages/kiosk-accessibility-sdk",
    "sdk:pack": "npm --prefix packages/kiosk-accessibility-sdk run pack:artifact",
    "sdk:verify-consumer": "npm run sdk:pack && node packages/kiosk-accessibility-sdk/scripts/verify-consumer.mjs",
    "test:menu-layout-browser": "node scripts/test-menu-layout-transform-browser.mjs",
    "test:menu-layout-diagnostics-browser": "node scripts/test-menu-layout-diagnostics-browser.mjs",
    "health:development": "NODE_ENV=development node scripts/check-central-health.mjs",
    "start": "NODE_ENV=production node server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/smartGuide.test.mjs src/menuLayoutPlan.test.mjs src/accessibility/autoMenuLayout.test.mjs src/accessibility/menuLayoutDiagnostics.test.mjs server/ai-layout-relay.test.mjs server/central-health-diagnostics.test.mjs packages/kiosk-accessibility-sdk/test/*.test.mjs",
    "test:smart-guide": "node --experimental-strip-types --test src/smartGuide.test.mjs packages/kiosk-accessibility-sdk/test/guide.test.mjs"
  },
  "keywords": [
    "cafe",
    "kiosk",
    "accessibility",
    "demo"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@replit/vite-plugin-cartographer": "^0.5.21",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@zxing/browser": "^0.2.1",
    "chokidar": "^4.0.3",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
