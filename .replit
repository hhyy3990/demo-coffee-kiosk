modules = ["nodejs-24", "python-base-3.13"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NODE_ENV=development AI_LAYOUT_RELAY_ENABLED=false AI_LAYOUT_RELAY_ONE_SHOT=false VITE_DEMO_COFFEE_AI_LAYOUT_AUTO=false VITE_DEMO_COFFEE_AI_LAYOUT_MOCK=false node --input-type=module -e 'import { createHash } from \"node:crypto\"; const base=process.env.AI_LAYOUT_CENTRAL_URL; const oldHostFingerprint=\"d3cea8ecce3af4d6e12daa35ef355e3b705cb082defe1da06f3e0facab97adc5\"; const out={centralUrlPresent:!!base,externalTokenPresent:!!process.env.AI_LAYOUT_REPLIT_EXTERNAL_TOKEN,serviceTokenPresent:!!process.env.AI_LAYOUT_SERVICE_TOKEN,parseable:false,https:false,developmentHost:false,rootBasePath:false,standardPort:false,noCredentials:false,noQueryOrFragment:false,healthPath:\"/api/health\",planPath:\"/api/ai-layout/plan\",sameOrigin:true,matchesHistoricalDocumentedHost:false}; try { if(base) { const u=new URL(base); out.parseable=true; out.https=u.protocol===\"https:\"; out.developmentHost=u.hostname.endsWith(\".replit.dev\")&&u.hostname!==\"naebangsikqr.replit.app\"; out.rootBasePath=u.pathname===\"/\"; out.standardPort=u.port===\"\"||u.port===\"443\"; out.noCredentials=!u.username&&!u.password; out.noQueryOrFragment=!u.search&&!u.hash; out.matchesHistoricalDocumentedHost=createHash(\"sha256\").update(u.hostname).digest(\"hex\")===oldHostFingerprint; } } catch {} console.log(JSON.stringify({stage:\"central_url_metadata\",...out}));' ; NODE_ENV=development AI_LAYOUT_RELAY_ENABLED=false AI_LAYOUT_RELAY_ONE_SHOT=false VITE_DEMO_COFFEE_AI_LAYOUT_AUTO=false VITE_DEMO_COFFEE_AI_LAYOUT_MOCK=false npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5017
externalPort = 3002

[[ports]]
localPort = 23636
externalPort = 3000

[[ports]]
localPort = 24678
externalPort = 80
