{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "paths": {
      "@naebangsik/kiosk-accessibility-sdk": ["./packages/kiosk-accessibility-sdk/src/index.ts"],
      "@naebangsik/kiosk-accessibility-sdk/*": ["./packages/kiosk-accessibility-sdk/src/*"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true
  },
  "include": ["src", "packages/kiosk-accessibility-sdk/src"]
}
